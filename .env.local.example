# KRAZIVO — Supabase environment template
# Copy this file to .env.local and fill in your project values, then restart the dev server.

# Supabase project URL (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co

# Public anon/publishable key — safe for the browser (RLS protects data).
# NEVER put the service_role key in this file.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# Optional: set to true only after enabling the Google provider in
# Supabase Dashboard → Authentication → Providers → Google
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED=false
